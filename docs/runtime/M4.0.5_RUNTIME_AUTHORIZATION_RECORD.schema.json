{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.labor-saving.cn/schemas/m4.0.5-runtime-authorization-record.schema.json",
  "title": "M4.0.5 Runtime Authorization Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "evidence_package_id",
    "operation_id",
    "milestone",
    "execution_scope",
    "approved_commands",
    "runtime_environment",
    "target_id",
    "target_host",
    "target_port",
    "target_database",
    "database_url_source",
    "database_url_fingerprint",
    "operator",
    "approver",
    "approval_reference",
    "approval_timestamp",
    "approval_expiry",
    "maintenance_window",
    "decision",
    "decision_timestamp"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "evidence_package_id": { "type": "string", "minLength": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "milestone": { "const": "M4.0.5" },
    "execution_scope": { "enum": ["live-readonly-validation", "controlled-migration"] },
    "approved_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["db:migrate:status", "db:health", "db:tx-smoke", "db:migrate", "db:acceptance"]
      }
    },
    "runtime_environment": { "enum": ["local", "staging", "production"] },
    "target_id": { "type": "string", "minLength": 1 },
    "target_host": { "type": "string", "minLength": 1 },
    "target_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "target_database": { "type": "string", "pattern": "^[A-Za-z0-9_$-]+$" },
    "database_url_source": { "enum": ["local-env", "process", "secret-store"] },
    "database_url_fingerprint": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "mysql://|://[^:]+:[^@]+@" }
    },
    "migration_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "operator": { "type": "string", "minLength": 1 },
    "approver": { "type": "string", "minLength": 1 },
    "approval_reference": { "type": "string", "minLength": 1 },
    "authorized_release_owner": { "type": "string", "minLength": 1 },
    "approval_timestamp": { "type": "string", "format": "date-time" },
    "approval_expiry": { "type": "string", "format": "date-time" },
    "maintenance_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" }
      }
    },
    "migration_user_provisioning_component_id": { "type": "string", "minLength": 1 },
    "backup_component_id": { "type": "string", "minLength": 1 },
    "rollback_component_id": { "type": "string", "minLength": 1 },
    "live_validation_component_id": { "type": "string", "minLength": 1 },
    "failure_stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision": {
      "enum": ["BLOCKED", "READY_FOR_LIVE_VALIDATION", "READY_FOR_CONTROLLED_EXECUTION", "EXECUTED"]
    },
    "decision_timestamp": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "execution_scope": { "const": "live-readonly-validation" } } },
      "then": {
        "required": ["migration_user_provisioning_component_id", "live_validation_component_id", "failure_stop_conditions"],
        "properties": {
          "approved_commands": {
            "items": { "enum": ["db:migrate:status", "db:health", "db:tx-smoke"] }
          },
          "decision": { "enum": ["BLOCKED", "READY_FOR_LIVE_VALIDATION", "EXECUTED"] }
        }
      }
    },
    {
      "if": { "properties": { "execution_scope": { "const": "controlled-migration" } } },
      "then": {
        "required": [
          "migration_set",
          "authorized_release_owner",
          "migration_user_provisioning_component_id",
          "backup_component_id",
          "rollback_component_id",
          "live_validation_component_id",
          "failure_stop_conditions"
        ],
        "properties": {
          "approved_commands": { "items": { "enum": ["db:migrate", "db:acceptance"] } },
          "decision": { "enum": ["BLOCKED", "READY_FOR_CONTROLLED_EXECUTION", "EXECUTED"] }
        }
      }
    }
  ]
}
