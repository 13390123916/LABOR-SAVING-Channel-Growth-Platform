{
  "name": "labor-saving-channel-growth-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/validate-product-rendering.mjs && npm run typecheck",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/runtime-execution-preflight.mjs --mode=controlled-execution --command=db:migrate",
    "db:migrate:status": "node scripts/runtime-execution-preflight.mjs --mode=live-validation --command=db:migrate:status",
    "db:health": "node scripts/runtime-execution-preflight.mjs --mode=live-validation --command=db:health",
    "db:tx-smoke": "node scripts/runtime-execution-preflight.mjs --mode=live-validation --command=db:tx-smoke",
    "db:validate": "node scripts/database-runtime-validation.mjs",
    "db:acceptance:preflight": "node scripts/runtime-execution-preflight.mjs --mode=structural --command=db:validate",
    "db:acceptance": "node scripts/runtime-execution-preflight.mjs --mode=controlled-execution --command=db:acceptance"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.18.0",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  }
}
