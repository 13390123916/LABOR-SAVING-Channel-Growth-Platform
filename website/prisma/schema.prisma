  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  parent   Navigation?  @relation("NavigationTree", fields: [parentId], references: [id])
  children Navigation[] @relation("NavigationTree")
  entity   Entity?      @relation(fields: [entityId], references: [entityId])

  @@unique([navGroup, parentId, slug])
  @@index([entityId])
  @@index([status, deletedAt])
  @@map("navigation")
}

model SeoMetadata {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId        String    @map("entity_id") @db.VarChar(32)
  pageUrl         String    @map("page_url") @db.VarChar(512)
