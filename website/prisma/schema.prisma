model Resource {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @unique @db.VarChar(128)
  status    String    @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  permissions Permission[]

  @@index([status, deletedAt])
  @@map("resources")
}

model Permission {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  resourceId BigInt    @map("resource_id") @db.UnsignedBigInt
  action     String    @db.VarChar(64)
  scope      String    @default("global") @db.VarChar(64)
  status     String    @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  resource        Resource         @relation(fields: [resourceId], references: [id])
  rolePermissions RolePermission[]

  @@unique([resourceId, action, scope])
  @@index([status, deletedAt])
  @@map("permissions")
}

model UserRole {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  roleId    BigInt    @map("role_id") @db.UnsignedBigInt
  status    String    @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([status, deletedAt])
  @@map("user_roles")
}

model RolePermission {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  roleId       BigInt    @map("role_id") @db.UnsignedBigInt
  permissionId BigInt    @map("permission_id") @db.UnsignedBigInt
  status       String    @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([status, deletedAt])
  @@map("role_permissions")
}

model Session {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt    @map("user_id") @db.UnsignedBigInt
  sessionToken  String    @unique @map("session_token") @db.VarChar(255)
  idleExpiresAt DateTime  @map("idle_expires_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model LoginEvent {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt?  @map("user_id") @db.UnsignedBigInt
  loginIdentifier String?  @map("login_identifier") @db.VarChar(191)
  success         Boolean
  failureReason   String?  @map("failure_reason") @db.VarChar(191)
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([loginIdentifier, createdAt])
  @@map("login_events")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorId      BigInt?  @map("actor_id") @db.UnsignedBigInt
  actorRoleIds Json?    @map("actor_role_ids")
  action       String   @db.VarChar(64)
  resource     String?  @db.VarChar(128)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  entityId     String?  @map("entity_id") @db.VarChar(32)
  targetTable  String?  @map("target_table") @db.VarChar(128)
  targetId     String?  @map("target_id") @db.VarChar(128)
  beforeJson   Json?    @map("before_json")
  afterJson    Json?    @map("after_json")
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.Text
  requestId    String?  @map("request_id") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at")

  actor  User?   @relation(fields: [actorId], references: [id])
  entity Entity? @relation(fields: [entityId], references: [entityId])

  @@index([actorId, createdAt])
  @@index([entityId, createdAt])
  @@index([resource, action])
  @@map("audit_logs")
}
