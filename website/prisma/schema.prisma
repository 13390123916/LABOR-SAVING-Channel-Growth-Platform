generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Entity {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId     String    @unique @map("entity_id") @db.VarChar(32)
  entityType   String    @map("entity_type") @db.VarChar(64)
  slug         String    @db.VarChar(191)
  name         String    @db.VarChar(191)
  summary      String?   @db.Text
  status       String    @db.VarChar(64)
  sourceStatus String?   @map("source_status") @db.VarChar(64)
  version      Int       @default(1)
  locale       String    @default("zh-CN") @db.VarChar(16)
  metadataId   BigInt?   @map("metadata_id") @db.UnsignedBigInt
  schemaId     BigInt?   @map("schema_id") @db.UnsignedBigInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  publishedAt  DateTime? @map("published_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    BigInt?   @map("created_by") @db.UnsignedBigInt
  updatedBy    BigInt?   @map("updated_by") @db.UnsignedBigInt
  publishedBy  BigInt?   @map("published_by") @db.UnsignedBigInt

  product              Product?
  industry             Industry?
  partner              Partner?
  article              Article?
  faq                  Faq?
  download             Download?
  media                Media?
  navigationItems      Navigation[]
  seoMetadata          SeoMetadata[]
  schemaMetadata       SchemaMetadata[]
  sourceRelations      EntityRelation[] @relation("EntityRelationSource")
  targetRelations      EntityRelation[] @relation("EntityRelationTarget")
  sourceMediaRelations EntityMedia[]    @relation("EntityMediaSource")
  targetMediaRelations EntityMedia[]    @relation("EntityMediaTarget")
  sourceFaqRelations   EntityFaq[]      @relation("EntityFaqSource")
  targetFaqRelations   EntityFaq[]      @relation("EntityFaqTarget")
  tagRelations         EntityTag[]
  auditLogs            AuditLog[]

  @@unique([entityType, slug, locale])
  @@index([status, deletedAt])
  @@map("entities")
}

model Category {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  categoryType String    @map("category_type") @db.VarChar(64)
  parentId     BigInt?   @map("parent_id") @db.UnsignedBigInt
  slug         String    @db.VarChar(191)
  name         String    @db.VarChar(191)
  description  String?   @db.Text
  locale       String    @default("zh-CN") @db.VarChar(16)
  displayOrder Int       @default(0) @map("display_order")
  status       String    @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  articles  Article[]
  downloads Download[]

  @@unique([categoryType, slug, locale])
  @@index([parentId])
  @@index([status, deletedAt])
  @@map("categories")
}

model Product {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId           String    @unique @map("entity_id") @db.VarChar(32)
  categoryId         BigInt    @map("category_id") @db.UnsignedBigInt
  productSlug        String    @map("product_slug") @db.VarChar(191)
  productName        String    @map("product_name") @db.VarChar(191)
  brand              String?   @db.VarChar(191)
  shortDescription   String?   @map("short_description") @db.Text
  targetUsers        Json?     @map("target_users")
  applicationSummary String?   @map("application_summary") @db.Text
  leadType           String?   @map("lead_type") @db.VarChar(64)
  cta                String?   @db.VarChar(191)
  detailStatus       String    @map("detail_status") @db.VarChar(64)
  schemaEligible     Boolean   @default(false) @map("schema_eligible")
  contentValidated   Boolean   @default(false) @map("content_validated")
  releaseApproved    Boolean   @default(false) @map("release_approved")
  status             String    @db.VarChar(64)
  version            Int       @default(1)
  locale             String    @default("zh-CN") @db.VarChar(16)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  publishedAt        DateTime? @map("published_at")
  deletedAt          DateTime? @map("deleted_at")

  entity            Entity            @relation(fields: [entityId], references: [entityId])
  category          Category          @relation(fields: [categoryId], references: [id])
  industryRelations ProductIndustry[] @relation("ProductIndustrySource")

  @@unique([categoryId, productSlug, locale])
  @@index([status, detailStatus, deletedAt])
  @@map("products")
}

model Industry {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId                 String    @unique @map("entity_id") @db.VarChar(32)
  slug                     String    @db.VarChar(191)
  name                     String    @db.VarChar(191)
  scenarioSummary          String?   @map("scenario_summary") @db.Text
  commonProblems           Json?     @map("common_problems")
  implementationConditions String?   @map("implementation_conditions") @db.Text
  leadType                 String?   @map("lead_type") @db.VarChar(64)
  status                   String    @db.VarChar(64)
  version                  Int       @default(1)
  locale                   String    @default("zh-CN") @db.VarChar(16)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  publishedAt              DateTime? @map("published_at")
  deletedAt                DateTime? @map("deleted_at")

  entity           Entity            @relation(fields: [entityId], references: [entityId])
  productRelations ProductIndustry[] @relation("ProductIndustryTarget")

  @@unique([slug, locale])
  @@index([status, deletedAt])
  @@map("industries")
}

model Partner {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId    String    @unique @map("entity_id") @db.VarChar(32)
  slug        String    @db.VarChar(191)
  programName String    @map("program_name") @db.VarChar(191)
  positioning String?   @db.Text
  targetRoles Json?     @map("target_roles")
  leadType    String?   @map("lead_type") @db.VarChar(64)
  cta         String?   @db.VarChar(191)
  status      String    @db.VarChar(64)
  version     Int       @default(1)
  locale      String    @default("zh-CN") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")
  deletedAt   DateTime? @map("deleted_at")

  entity Entity @relation(fields: [entityId], references: [entityId])

  @@unique([slug, locale])
  @@index([status, deletedAt])
  @@map("partners")
}

model Lead {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  leadNo              String    @unique @map("lead_no") @db.VarChar(64)
  leadType            String    @map("lead_type") @db.VarChar(64)
  companyName         String?   @map("company_name") @db.VarChar(191)
  contactName         String?   @map("contact_name") @db.VarChar(191)
  phone               String?   @db.VarChar(64)
  region              String?   @db.VarChar(191)
  industry            String?   @db.VarChar(191)
  mainProducts        String?   @map("main_products") @db.Text
  customerResources   String?   @map("customer_resources") @db.Text
  cooperationIntent   String?   @map("cooperation_intent") @db.Text
  interestedProduct   String?   @map("interested_product") @db.VarChar(191)
  applicationScenario String?   @map("application_scenario") @db.Text
  projectStage        String?   @map("project_stage") @db.VarChar(64)
  sourceChannel       String?   @map("source_channel") @db.VarChar(64)
  sourcePage          String?   @map("source_page") @db.VarChar(191)
  sourceCampaign      String?   @map("source_campaign") @db.VarChar(191)
  status              String    @db.VarChar(64)
  assignedTo          BigInt?   @map("assigned_to") @db.UnsignedBigInt
  contactedAt         DateTime? @map("contacted_at")
  qualifiedAt         DateTime? @map("qualified_at")
  closedAt            DateTime? @map("closed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  assignee User? @relation("LeadAssignee", fields: [assignedTo], references: [id])

  @@index([leadType, status])
  @@index([assignedTo])
  @@map("leads")
}

model Media {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId         String    @unique @map("entity_id") @db.VarChar(32)
  assetType        String    @map("asset_type") @db.VarChar(64)
  assetPath        String    @unique @map("asset_path") @db.VarChar(512)
  originalFilename String?   @map("original_filename") @db.VarChar(255)
  mimeType         String?   @map("mime_type") @db.VarChar(128)
  fileSize         BigInt?   @map("file_size") @db.UnsignedBigInt
  altText          String?   @map("alt_text") @db.VarChar(255)
  caption          String?   @db.Text
  sourceStatus     String?   @map("source_status") @db.VarChar(64)
  licenseStatus    String?   @map("license_status") @db.VarChar(64)
  usageScope       String?   @map("usage_scope") @db.VarChar(191)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  entity              Entity        @relation(fields: [entityId], references: [entityId])
  downloads           Download[]
  seoMetadataOgImages SeoMetadata[]

  @@index([licenseStatus, deletedAt])
  @@map("media")
}

model Article {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId       String    @unique @map("entity_id") @db.VarChar(32)
  categoryId     BigInt?   @map("category_id") @db.UnsignedBigInt
  slug           String    @db.VarChar(191)
  title          String    @db.VarChar(191)
  summary        String?   @db.Text
  content        String?   @db.LongText
