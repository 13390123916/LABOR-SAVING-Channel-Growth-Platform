  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  sourceEntity Entity @relation("EntityRelationSource", fields: [sourceEntityId], references: [entityId])
  targetEntity Entity @relation("EntityRelationTarget", fields: [targetEntityId], references: [entityId])

  @@unique([sourceEntityId, targetEntityId, relationType])
  @@index([targetEntityId])
  @@index([status, deletedAt])
  @@map("entity_relations")
}

