  schemaJson      Json      @map("schema_json")
  sourceDoc       String?   @map("source_doc") @db.VarChar(191)
  sourceStatus    String?   @map("source_status") @db.VarChar(64)
  locale          String    @default("zh-CN") @db.VarChar(16)
  status          String    @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  publishedAt     DateTime? @map("published_at")
  deletedAt       DateTime? @map("deleted_at")
  indexedAt       DateTime? @map("indexed_at")
  lastSubmittedAt DateTime? @map("last_submitted_at")

  entity Entity @relation(fields: [entityId], references: [entityId])

