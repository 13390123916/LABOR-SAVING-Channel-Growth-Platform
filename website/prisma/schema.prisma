  locale         String    @default("zh-CN") @db.VarChar(16)
  status         String    @db.VarChar(64)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  publishedAt    DateTime? @map("published_at")
  deletedAt      DateTime? @map("deleted_at")

  entity       Entity       @relation(fields: [entityId], references: [entityId])
  category     Category?    @relation(fields: [categoryId], references: [id])
  tagRelations ArticleTag[]

  @@unique([slug, locale])
  @@index([categoryId])
  @@index([status, deletedAt])
  @@map("articles")
}

model Faq {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId     String    @unique @map("entity_id") @db.VarChar(32)
  question     String    @db.Text
  answer       String    @db.Text
  questionHash String    @map("question_hash") @db.VarChar(128)
  locale       String    @default("zh-CN") @db.VarChar(16)
  status       String    @db.VarChar(64)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  publishedAt  DateTime? @map("published_at")
  deletedAt    DateTime? @map("deleted_at")

  entity Entity @relation(fields: [entityId], references: [entityId])

  @@unique([entityId, questionHash, locale])
  @@index([status, deletedAt])
  @@map("faqs")
}

model Download {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  entityId      String    @unique @map("entity_id") @db.VarChar(32)
  categoryId    BigInt?   @map("category_id") @db.UnsignedBigInt
  slug          String    @db.VarChar(191)
  title         String    @db.VarChar(191)
  summary       String?   @db.Text
  mediaId       BigInt?   @map("media_id") @db.UnsignedBigInt
  publicAccess  Boolean   @default(false) @map("public_access")
  licenseStatus String?   @map("license_status") @db.VarChar(64)
  status        String    @db.VarChar(64)
  version       Int       @default(1)
  locale        String    @default("zh-CN") @db.VarChar(16)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  publishedAt   DateTime? @map("published_at")
  deletedAt     DateTime? @map("deleted_at")

  entity   Entity    @relation(fields: [entityId], references: [entityId])
  category Category? @relation(fields: [categoryId], references: [id])
  media    Media?    @relation(fields: [mediaId], references: [id])

  @@unique([slug, locale])
  @@index([categoryId])
  @@index([mediaId])
  @@index([status, deletedAt])
  @@map("downloads")
}

model Navigation {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  navGroup     String    @map("nav_group") @db.VarChar(64)
  parentId     BigInt?   @map("parent_id") @db.UnsignedBigInt
  slug         String    @db.VarChar(191)
  label        String    @db.VarChar(191)
  url          String?   @db.VarChar(512)
  entityId     String?   @map("entity_id") @db.VarChar(32)
